<Window x:Class="ShiftCalendar.Views.AssignSubstituteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначить замещающего" Height="500" Width="500"
        Background="#252525" Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Дата:" FontSize="14" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" x:Name="DateText" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#ccc"/>

        <TextBlock Grid.Row="2" Text="Выберите смену и сотрудника:" FontSize="14" Margin="0,0,0,10"/>

        <!-- Выбор смены -->
        <ComboBox Grid.Row="2" x:Name="TeamSelector" Margin="0,25,0,10" 
                 Background="#1a1a1a" Foreground="White" Padding="8"
                 SelectionChanged="TeamSelector_SelectionChanged"/>

        <!-- Список сотрудников -->
        <ListBox Grid.Row="3" x:Name="EmployeesList" Background="#1a1a1a" Foreground="#e0e0e0" 
                BorderBrush="#444" BorderThickness="1" Padding="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13" Padding="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Отмена" Click="CancelButton_Click" 
                   Background="#424242" Foreground="#e0e0e0" Padding="15,8" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Назначить" Click="AssignButton_Click" 
                   Background="#4CAF50" Foreground="White" Padding="15,8"/>
        </Grid>
    </Grid>
</Window>