<Window x:Class="ShiftCalendar.Views.EditShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить смену" Height="300" Width="350"
        Background="#252525" Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите тип смены:" FontSize="16" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <RadioButton Content="День (12 часов)" GroupName="Shift" Tag="День" 
                        Margin="0,0,0,10" Foreground="#e0e0e0"/>
            <RadioButton Content="Ночь (4 часа)" GroupName="Shift" Tag="Ночь" 
                        Margin="0,0,0,10" Foreground="#e0e0e0"/>
            <RadioButton Content="Утро (8 часов)" GroupName="Shift" Tag="Утро" 
                        Margin="0,0,0,10" Foreground="#e0e0e0"/>
            <RadioButton Content="Выходной" GroupName="Shift" Tag="Выходной" 
                        Margin="0,0,0,10" Foreground="#e0e0e0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Отмена" Click="CancelButton_Click" 
                   Background="#424242" Foreground="#e0e0e0" Padding="15,8" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Сохранить" Click="SaveButton_Click" 
                   Background="#4CAF50" Foreground="White" Padding="15,8"/>
        </Grid>
    </Grid>
</Window>