<Window x:Class="ShiftCalendar.Views.EditTeamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление сменами и сотрудниками" Height="600" Width="800"
        Background="#252525" Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Редактирование смен и сотрудников" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TeamsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2a2a2a" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                            Background="#1a1a1a" Foreground="White" Padding="5" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#888">
                                        <Run Text="Сдвиг: "/>
                                        <Run Text="{Binding CycleOffset}"/>
                                        <Run Text=" дн."/>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Text="Сотрудники:" Foreground="#888" FontSize="12" Margin="0,0,0,5"/>

                                <ItemsControl ItemsSource="{Binding Employees}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding FullName}" 
                                                        Background="#1a1a1a" Foreground="White" Padding="5" Margin="0,0,5,0"/>
                                                <Button Grid.Column="1" Content="✕" Width="30" Height="30"
                                                       Background="#d32f2f" Foreground="White" BorderThickness="0"
                                                       Click="RemoveEmployee_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+ Добавить сотрудника" Width="200" HorizontalAlignment="Left"
                                       Background="#4CAF50" Foreground="White" Padding="10,5" Margin="0,5,0,0"
                                       Click="AddEmployee_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Отмена" Click="CancelButton_Click" 
                   Background="#424242" Foreground="#e0e0e0" Padding="15,8" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Сохранить" Click="SaveButton_Click" 
                   Background="#4CAF50" Foreground="White" Padding="15,8"/>
        </Grid>
    </Grid>
</Window>